import { NextRequest, NextResponse } from 'next/server';
import { createClient } from '@supabase/supabase-js';
import { serverEnv, maskServerKey } from '@/lib/serverEnv';

const supabaseUrl = serverEnv.SUPABASE_URL;
const anonKey = serverEnv.SUPABASE_ANON_KEY;
const serviceRoleKey = serverEnv.SUPABASE_SERVICE_ROLE_KEY;

type AdminRole = 'admin' | 'editor' | 'viewer';

function json(status: number, body: unknown) {
  return NextResponse.json(body, { status });
}

async function requireAdmin(request: NextRequest) {
  console.log('SERVER_ROUTE_ENV_USERS', { service: maskServerKey(serviceRoleKey), anon: maskServerKey(anonKey), url: supabaseUrl });
  if (!supabaseUrl || !anonKey || !serviceRoleKey) {
    return { error: json(500, { error: 'Supabase server env missing. Set SUPABASE_SERVICE_ROLE_KEY.' }) };
  }

  const authHeader = request.headers.get('authorization') || '';
  const token = authHeader.replace(/^Bearer\s+/i, '').trim();

  if (!token) return { error: json(401, { error: 'Missing bearer token' }) };

  const userClient = createClient(supabaseUrl, anonKey, {
    auth: { persistSession: false, autoRefreshToken: false },
  });

  const { data: userData, error: userError } = await userClient.auth.getUser(token);
  if (userError || !userData.user) {
    return { error: json(401, { error: userError?.message || 'Invalid session' }) };
  }

  const service = createClient(supabaseUrl, serviceRoleKey, {
    auth: { persistSession: false, autoRefreshToken: false },
  });

  const { data: roleRows, error: roleError } = await service
    .from('user_roles')
    .select('role')
    .eq('user_id', userData.user.id);

  if (roleError) return { error: json(500, { error: roleError.message }) };

  const roles = (roleRows || []).map((row) => row.role);
  if (!roles.includes('admin')) return { error: json(403, { error: 'Admin role required' }) };

  return { service };
}

export async function GET(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;

  const { data: authData, error: authError } = await service.auth.admin.listUsers({ page: 1, perPage: 1000 });
  if (authError) return json(500, { error: authError.message });

  const { data: roleRows, error: roleError } = await service
    .from('user_roles')
    .select('user_id, role, created_at, updated_at')
    .order('created_at', { ascending: false });

  if (roleError) return json(500, { error: roleError.message });

  const roleByUserId = new Map((roleRows || []).map((row) => [row.user_id, row]));

  const users = authData.users.map((user) => {
    const roleRow = roleByUserId.get(user.id);
    const email = user.email || '';
    const displayName =
      (user.user_metadata?.display_name as string | undefined) ||
      (user.user_metadata?.full_name as string | undefined) ||
      email.split('@')[0] ||
      'User';

    return {
      user_id: user.id,
      display_name: displayName,
      email,
      role: (roleRow?.role || 'viewer') as AdminRole,
      status: user.banned_until ? 'disabled' : 'active',
      created_at: user.created_at || new Date().toISOString(),
      updated_at: roleRow?.updated_at || user.updated_at || user.created_at || new Date().toISOString(),
    };
  });

  return json(200, { users });
}

export async function PATCH(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;
  const body = await request.json();

  const user_id = String(body.user_id || '');
  const role = String(body.role || '') as AdminRole;

  if (!user_id || !['admin', 'editor', 'viewer'].includes(role)) {
    return json(400, { error: 'Invalid user_id or role' });
  }

  const existing = await service
    .from('user_roles')
    .select('user_id, role')
    .eq('user_id', user_id)
    .maybeSingle();

  if (existing.error) return json(500, { error: existing.error.message });

  const write = existing.data
    ? await service
        .from('user_roles')
        .update({ role, updated_at: new Date().toISOString() })
        .eq('user_id', user_id)
        .select('user_id, role')
        .single()
    : await service
        .from('user_roles')
        .insert({ user_id, role, updated_at: new Date().toISOString() })
        .select('user_id, role')
        .single();

  if (write.error) return json(500, { error: write.error.message });

  if (write.data?.role !== role) {
    return json(500, {
      error: 'Role write verification failed',
      expected: role,
      actual: write.data?.role || null,
      row: write.data,
    });
  }

  return json(200, {
    ok: true,
    message: 'Role saved and verified',
    user_id,
    role: write.data.role,
    row: write.data,
  });
}

export async function DELETE(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;
  const body = await request.json();

  const user_id = String(body.user_id || '');
  if (!user_id) return json(400, { error: 'Invalid user_id' });

  const roleDelete = await service.from('user_roles').delete().eq('user_id', user_id);
  if (roleDelete.error) return json(500, { error: roleDelete.error.message });

  const authDelete = await service.auth.admin.deleteUser(user_id);
  if (authDelete.error) return json(500, { error: authDelete.error.message });

  return json(200, { ok: true, message: 'Auth user and role deleted' });
}

export async function POST(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;
  const body = await request.json();

  const email = String(body.email || '').trim().toLowerCase();
  const password = String(body.password || '').trim();
  const displayName = String(body.display_name || '').trim();
  const role = String(body.role || 'viewer') as AdminRole;

  if (!email || !['admin', 'editor', 'viewer'].includes(role)) {
    return json(400, { error: 'Invalid email or role' });
  }

  if (!password || password.length < 6) {
    return json(400, { error: 'Password must be at least 6 characters' });
  }

  const existing = await service.auth.admin.listUsers({ page: 1, perPage: 1000 });
  if (existing.error) return json(500, { error: existing.error.message });

  let user = existing.data.users.find((u) => (u.email || '').toLowerCase() === email);

  if (!user) {
    const created = await service.auth.admin.createUser({
      email,
      password,
      email_confirm: true,
      user_metadata: {
        display_name: displayName || email.split('@')[0] || 'User',
        full_name: displayName || email.split('@')[0] || 'User',
      },
    });

    if (created.error || !created.data.user) {
      return json(500, { error: created.error?.message || 'Create auth user failed' });
    }

    user = created.data.user;
  } else if (password) {
    const updated = await service.auth.admin.updateUserById(user.id, {
      password,
      user_metadata: {
        ...(user.user_metadata || {}),
        display_name: displayName || user.user_metadata?.display_name || email.split('@')[0] || 'User',
        full_name: displayName || user.user_metadata?.full_name || email.split('@')[0] || 'User',
      },
    });

    if (updated.error) return json(500, { error: updated.error.message });
    user = updated.data.user || user;
  }

  const { error: roleError } = await service.from('user_roles').upsert({
    user_id: user.id,
    role,
    updated_at: new Date().toISOString(),
  });

  if (roleError) return json(500, { error: roleError.message });

  return json(200, {
    ok: true,
    user: {
      user_id: user.id,
      display_name:
        (user.user_metadata?.display_name as string | undefined) ||
        (user.user_metadata?.full_name as string | undefined) ||
        email.split('@')[0] ||
        'User',
      email: user.email || email,
      role,
      status: user.banned_until ? 'disabled' : 'active',
      created_at: user.created_at || new Date().toISOString(),
    },
    message: `Auth user and role saved for ${email}`,
  });
}

export async function PUT(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;
  const body = await request.json();

  const user_id = String(body.user_id || '');
  const action = String(body.action || '');

  if (!user_id || !['disable', 'enable'].includes(action)) {
    return json(400, { error: 'Invalid user_id or action' });
  }

  const update = await service.auth.admin.updateUserById(user_id, {
    ban_duration: action === 'disable' ? '876000h' : 'none',
  });

  if (update.error) return json(500, { error: update.error.message });

  return json(200, {
    ok: true,
    message: action === 'disable' ? 'User disabled' : 'User enabled',
  });
}


