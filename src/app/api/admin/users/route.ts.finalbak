import { NextRequest, NextResponse } from 'next/server';
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.VITE_SUPABASE_URL || '';
const anonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || process.env.VITE_SUPABASE_ANON_KEY || '';
const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY || '';

type AdminRole = 'admin' | 'editor' | 'viewer';

function json(status: number, body: unknown) {
  return NextResponse.json(body, { status });
}

async function requireAdmin(request: NextRequest) {
  if (!supabaseUrl || !anonKey || !serviceRoleKey) {
    return { error: json(500, { error: 'Supabase server env missing. Set SUPABASE_SERVICE_ROLE_KEY.' }) };
  }

  const authHeader = request.headers.get('authorization') || '';
  const token = authHeader.replace(/^Bearer\s+/i, '').trim();

  if (!token) return { error: json(401, { error: 'Missing bearer token' }) };

  const userClient = createClient(supabaseUrl, anonKey);
  const { data: userData, error: userError } = await userClient.auth.getUser(token);
  if (userError || !userData.user) return { error: json(401, { error: 'Invalid session' }) };

  const service = createClient(supabaseUrl, serviceRoleKey, {
    auth: { persistSession: false, autoRefreshToken: false },
  });

  const { data: roleRows, error: roleError } = await service
    .from('user_roles')
    .select('role')
    .eq('user_id', userData.user.id);

  if (roleError) return { error: json(500, { error: roleError.message }) };

  const roles = (roleRows || []).map((row) => row.role);
  if (!roles.includes('admin')) return { error: json(403, { error: 'Admin role required' }) };

  return { service };
}

export async function GET(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;

  const { data: authData, error: authError } = await service.auth.admin.listUsers({ page: 1, perPage: 1000 });
  if (authError) return json(500, { error: authError.message });

  const { data: roleRows, error: roleError } = await service
    .from('user_roles')
    .select('user_id, role, created_at, updated_at')
    .order('created_at', { ascending: false });

  if (roleError) return json(500, { error: roleError.message });

  const users = authData.users.map((user) => {
    const role = (roleRows || []).find((row) => row.user_id === user.id);
    return {
      user_id: user.id,
      display_name:
        (user.user_metadata?.display_name as string | undefined) ||
        (user.user_metadata?.full_name as string | undefined) ||
        '',
      email: user.email || '',
      role: (role?.role || 'viewer') as AdminRole,
      status: user.banned_until ? 'disabled' : 'active',
      created_at: user.created_at || new Date().toISOString(),
    };
  });

  return json(200, { users });
}

export async function PATCH(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;
  const body = await request.json();
  const user_id = String(body.user_id || '');
  const role = String(body.role || '') as AdminRole;

  if (!user_id || !['admin', 'editor', 'viewer'].includes(role)) {
    return json(400, { error: 'Invalid user_id or role' });
  }

  const { error } = await service.from('user_roles').upsert({
    user_id,
    role,
    updated_at: new Date().toISOString(),
  });

  if (error) return json(500, { error: error.message });

  return json(200, { ok: true });
}

export async function DELETE(request: NextRequest) {
  const gate = await requireAdmin(request);
  if ('error' in gate) return gate.error;

  const { service } = gate;
  const body = await request.json();
  const user_id = String(body.user_id || '');

  if (!user_id) return json(400, { error: 'Invalid user_id' });

  const { error } = await service.from('user_roles').delete().eq('user_id', user_id);
  if (error) return json(500, { error: error.message });

  return json(200, { ok: true });
}
